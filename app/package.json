{
  "name": "kitagoya-production-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "production:seed:export": "tsx scripts/export-production-seed.ts",
    "production:seed:import": "tsx scripts/import-production-seed.ts",
    "import:products": "tsx scripts/rebuild-products-from-classification.ts --apply",
    "import:products:legacy": "tsx scripts/import-products.ts",
    "import:materials": "tsx scripts/import-materials.ts",
    "import:packaging": "tsx scripts/import-packaging.ts",
    "import:lead-times": "tsx scripts/import-lead-times.ts",
    "import:product-monthly-actuals": "tsx scripts/import-product-monthly-actuals.ts",
    "import:kitanagoya-actuals": "tsx scripts/import-kitanagoya-production-actuals.ts",
    "import:shifts": "tsx scripts/import-shifts.ts",
    "import:work-areas": "tsx scripts/import-work-areas.ts",
    "import:capacities": "tsx scripts/import-capacities.ts",
    "import:labor-capacities": "tsx scripts/import-labor-capacities.ts",
    "backfill:capacity-room-candidates": "tsx scripts/backfill-capacity-room-candidates.ts",
    "rebuild:products:classification": "tsx scripts/rebuild-products-from-classification.ts",
    "link:products:classification": "tsx scripts/link-classification-products.ts",
    "import:all": "npm run import:products && npm run import:materials && npm run import:packaging && npm run link:products:classification -- --apply && npm run import:shifts && npm run import:capacities && npm run import:labor-capacities",
    "apply:known-unit-prices": "tsx scripts/apply-known-unit-prices.ts",
    "export:unit-price-confirmation": "tsx scripts/export-unit-price-confirmation.ts",
    "inspect:xlsx": "tsx scripts/inspect-xlsx.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
