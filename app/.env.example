# Supabase PostgreSQL.
# Use the pooled connection URL for runtime (Vercel) and the direct/session URL for Prisma migrations.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Local migration from the handoff SQLite DB to Supabase.
SOURCE_SQLITE_DB="./prisma/dev.db"
PRODUCTION_SEED_PATH="./tmp/production-seed.json"

# Mount points used when this app is embedded in the ks-c system.
# Standalone local rewrites in next.config.ts route these paths back to the current pages/APIs.
NEXT_PUBLIC_KITAGOYA_BASE_PATH=/manufacturing/kitanagoya
NEXT_PUBLIC_KITAGOYA_API_BASE_PATH=/api/kitanagoya
